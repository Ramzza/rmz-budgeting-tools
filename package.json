{
  "name": "rmz-budgeting-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Monthly budgeting CLI for Revolut spending, market data, and Google Sheets",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rmz-budgeting-tools": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "test:requirements": "node --import tsx --test tests/*.test.ts",
    "test": "npm run build && npm run test:requirements",
    "start": "node dist/cli.js",
    "dev": "node --import tsx src/cli.ts",
    "start:sheets": "node dist/cli.js sheets",
    "start:market-data": "node dist/cli.js market-data",
    "start:revolut-spending": "node dist/cli.js revolut",
    "test:connection": "node --env-file=.env --import tsx --test tests/sheets-connection.integration.ts",
    "test:browser-snapshot": "node node_modules/@playwright/test/cli.js test tests/revolut-browser-snapshot.spec.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^14.0.0",
    "googleapis": "^183.0.0",
    "playwright": "^1.63.0",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
